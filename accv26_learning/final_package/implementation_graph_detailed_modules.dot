digraph implementation_graph_high_level {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    splines=ortho,
    overlap=false,
    nodesep=0.42,
    ranksep=0.70,
    fontsize=18,
    fontname="Helvetica",
    labelloc=t,
    label="High-level implementation graph reconstructed from experiments_related implementation-only export"
  ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#444444", fontname="Helvetica", fontsize=11, margin="0.08,0.05"];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  subgraph cluster_legend {
    label="Legend";
    color="#bbbbbb";
    style="rounded,dashed";
    legend_data [label="Data / filesystem layout", fillcolor="#e7f0ff"];
    legend_training [label="Training / model code", fillcolor="#eaffea"];
    legend_eval [label="Metrics / evaluation / visualization", fillcolor="#fff2cc"];
    legend_external [label="External repo/checkpoint dependency", fillcolor="#f7e7ff"];
    legend_artifact [label="Produced artifact / staged output", fillcolor="#eeeeee"];
    legend_solid [label="solid edge = direct import, call, or script-level wiring", fillcolor="#ffffff"];
    legend_dash [label="dashed edge = staged file/output dependency inferred from paths or CLI", fillcolor="#ffffff"];
  }

  subgraph cluster_inputs {
    label="OccuFly inputs and shared conventions";
    color="#8fb7ff";
    style="rounded";
    node [fillcolor="#e7f0ff"];
    occufly_raw [label="OccuFly raw layout\nscene_XX/{30,40,50}/images/visual\ndepth_maps + calibration.txt\npaths cited in scripts/03,06,07,dpt_decoder"];
    occufly_depth_loader [label="Depth sample loaders\nOccuFlyDepthDataset + collect_occufly_samples\nscripts/03, scripts/06, scripts/07, scripts/dpt_decoder/*"];
    occufly_video_builder [label="Video materialization\nMP4 clips from visual frames\nscripts/11_vjepa21_finetune_occufly_video.py"];
    occufly_video_loader [label="Video depth loaders\nclip modes: repeated / real / shuffled\nvjepa21video_scripts/src/vjepa21video_depth"];
    occufly_ssc_loader [label="SSC loaders\nOccuFlySSCDataset, labels, grid spec\nscripts_ssc/*/vjepafoundationssc/occufly_ssc_data.py\noccufly_labels.py, occufly_grid_config.json"];
  }

  subgraph cluster_external {
    label="External code/checkpoint dependencies";
    color="#d3a3ff";
    style="rounded";
    node [fillcolor="#f7e7ff"];
    ext_vjepa2 [label="V-JEPA / V-JEPA 2.1 repo + checkpoints\nreferenced by scripts/03,08,11\nbackbone_factory.py, video_backbone_factory.py"];
    ext_dinov3 [label="DINOv3 depth modules\ndinov3.eval.depth.models/loss\nreferenced by scripts/06,07 and DPT-FiLM heads"];
    ext_foundationssc [label="FoundationSSC external root\nbootstrap_foundationssc + real_adapters.py\nused by hybrid SSC"];
    ext_cgformer [label="CGFormer external scripts/checkpoints\nscripts_ssc/cgformer/common/*.sh, *.py"];
  }

  subgraph cluster_mde {
    label="Monocular depth estimation (MDE) family";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    mde_lp [label="MDE-LP\nfrozen V-JEPA2.1 + linear depth head\nscripts/03_train_vjepa_linear_depth.py"];
    mde_dino_lp [label="DINO-style linear probe\nV-JEPA adapter + DINOv3 depther\nscripts/06_vjepa21_dinov3_linearprobe_occufly.py\nscripts/vjepa21_dinov3_depth_adapter.py"];
    mde_dpt [label="DPT multi-layer decoder\nselected V-JEPA layers -> DPT\nscripts/07_vjepa21_dinov3_DPT_multilayer_decoder_occufly.py"];
    mde_dpt_film [label="DPT-FiLM depth\naltitude + intrinsics metadata conditioning\nscripts/dpt_decoder/train_vjepa21_vitG_dpt_film_occufly.py"];
    mde_alt [label="Altitude feature-plane DPT\nscripts/dpt_decoder/train_vjepa21_vitG_dpt_altitude_feature_occufly.py"];
    mde_sfp [label="Final-layer SFP + DPT-FiLM\nscripts/dpt_decoder/train_vjepa21_vitG_final_sfp_dpt_film_occufly.py"];
    mde_outputs [label="MDE outputs\ncheckpoints, metrics.json/csv, depth predictions\noutputs/results/*; export_depth_prediction_targets.py", fillcolor="#eeeeee"];
    mde_viz_diag [label="MDE diagnostics / visualization\nconstant depth, scale/shift checks, viewers\nscripts/diagnostics/*, scripts/visualization/*", fillcolor="#fff2cc"];
  }

  subgraph cluster_ft {
    label="V-JEPA2.1 OccuFly adaptation wrappers";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    rgb_ft [label="RGB JEPA fine-tuning wrapper\nwrites manifest/config; calls vjepa2/app/main.py\nscripts/08_vjepa21_finetune_occufly.py"];
    video_ft [label="Video JEPA fine-tuning wrapper\nmaterializes MP4s; writes config; calls vjepa2/app/main.py\nscripts/11_vjepa21_finetune_occufly_video.py"];
    ft_ckpts [label="Fine-tuned checkpoints / run dirs\noutputs/results/vjepa21_*_finetune_occufly_*", fillcolor="#eeeeee"];
    ft_probes [label="Fine-tuned feature probes\nlinear + DPT wrappers/sweeps\nscripts/10_vjepa21_finetuned_linearprobe_occufly.py\nscripts/11_vjepa21_finetuned_DPT_multilayer_decoder_occufly.py\nrun_finetuned_*_sweep_ddp.sh"];
  }

  subgraph cluster_video_depth {
    label="Video-depth family";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    stlp [label="ST-LP video depth\nspatio-temporal linear probe\nvjepa21video_scripts/scripts/train_stlp_depth.py\nsrc/vjepa21video_depth/*"];
    dta [label="DTA DPT-FiLM video depth\ndense temporal attention + DPT-FiLM\nvjepa21video_scripts/vjepa21video_dptfilm_attention/*"];
    video_depth_outputs [label="Video-depth outputs\nmetrics/checkpoints/visualizations\nrun_all_stlp_experiments.sh; visualizations_rgv_vs_video/*", fillcolor="#eeeeee"];
  }

  subgraph cluster_seg {
    label="Semantic segmentation launcher family";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    voc_download [label="VOC2012 download helper\nscripts_segmentation/dataset_download/download_voc12.sh"];
    seg_linear [label="DINOv3/V-JEPA linear segmentation sweeps\nrun_vjepa21_voc12_linear_sweep.sh\nrun_vjepa21_occufly_linear_sweep.sh\noccufly_21class_label_map.json"];
  }

  subgraph cluster_ssc {
    label="Semantic scene completion (SSC) family";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    ssc_scaffold [label="V-JEPA FoundationSSC scaffold\nbackbone, context_head, DPT-FiLM depth prob, frustum pool, SimpleSSCDecoder3D\nscripts_ssc/vjepafoundationssc/*"];
    ssc_frozen [label="Frozen-depth-head variant\nscripts_ssc/vjepafoundationssc_frozendepthhead/*\nrun_occufly_frozendepthhead.sh"];
    ssc_hybrid_train [label="Video/RGB pose-MVS consistent FoundationSSC hybrid trainer\ntrain_vjepa_occufly_ssc.py\nscripts_ssc/vjepa21video_posemvs_film_consistent_foundationssc_hybrid/vjepafoundationssc"];
    ssc_hybrid_backbones [label="RGB/video V-JEPA feature extractors + temporal adapters\nbackbone_factory.py, video_backbone_factory.py, temporal_attention.py"];
    ssc_hybrid_geometry [label="Geometry branches\nDPTFiLMDepthProbabilityHead OR PoseAwareMVSDepthHead\ndpt_film_depth_probability_head.py, pose_mvs_geometry.py"];
    ssc_hybrid_foundation [label="FoundationSSC adapter stack\nGeometryAwareContextAdapter, HybridViewTransformer, Decoder3D\nfoundation_ssc/real_adapters.py + wrappers"];
    ssc_hybrid_losses [label="SSC losses and metrics\nlosses_ssc.py, metrics_ssc.py\nreevaluate_validation_metrics.py, evaluate_grouped_metrics.py", fillcolor="#fff2cc"];
    ssc_hybrid_outputs [label="SSC outputs\nssc_best.pt, ssc_latest.pt, epoch ckpts, metrics, visuals\nvisualize_after_meaningful_test.py; sweep_overprob_*", fillcolor="#eeeeee"];
    ssc_variants [label="Related hybrid snapshots/variants\nposemvs_foundationssc_hybrid, vjepaF2D...BACKUP, improved, metadata_frozen_depthfix\nunder scripts_ssc/*foundationssc*", fillcolor="#eeeeee"];
  }

  subgraph cluster_cg {
    label="CGFormer / Aero-JEPA SSC ablation project";
    color="#8fd48f";
    style="rounded";
    node [fillcolor="#eaffea"];
    cg_common [label="CGFormer common preparation/eval helpers\nprepare_cgformer_occufly.py, eval_occufly_predictions.py\nevaluate_cgformer_checkpoint.sh, make_occufly_depth_prior_tree.py"];
    aero_cfg [label="Aero-JEPA config variants\nbaseline, final, M1-M6, sweeps\nscripts_ssc/cgformer/aero_jepa_ssc_project/configs/occufly/*.yaml\nsrc/aero_jepa_ssc/config.py"];
    aero_data [label="Aero-JEPA data/geometry layer\noccufly_dataset.py, depth_prior_teacher.py, pair_sampler.py\ncamera.py, latent_projector.py, world_voxel_alignment.py"];
    aero_model [label="Aero-JEPA model wrappers\naero_jepa_ssc.py, base_ssc_adapter.py, altitude_lifting.py, vjepa2_wrapper.py\nmask_generators.py, masked_3d_head.py"];
    aero_losses [label="Aero-JEPA losses\nssc_loss, altitude_depth_teacher, vjepa_distill, latent_view, masked_3d, output_consistency\nlosses/*.py"];
    aero_tools [label="Aero-JEPA tools/tests\ntrain_occufly.py, eval_occufly.py, cache_vjepa_features.py, make_table3.py\ntests/test_*.py", fillcolor="#fff2cc"];
    aero_outputs [label="Ablation outputs / Table 3 inputs\nrun_ablation_queue.sh, run_table3_experiments.sh, make_table3.py", fillcolor="#eeeeee"];
  }

  subgraph cluster_quality {
    label="Cross-cutting diagnostics, tests, reporting";
    color="#d7c48f";
    style="rounded";
    node [fillcolor="#fff2cc"];
    base_tests [label="Repository tests\ntests/test_mask_aware_depth_resize.py\ntests/test_occufly_ssc_metrics.py"];
    cg_tests [label="Aero-JEPA tests\ntest_altitude_*, test_vjepa_cache.py, test_table3_provenance.py, ..."];
    paper_tables [label="Paper/report aggregation\npaper_mde_grouped_tables.py\nbest20rmse_mde_pipeline/update_best20rmse.py\nforpaper_report snapshots"];
    global_viz [label="Depth/SSC/live viewers and panels\nscripts/visualization/*\nscripts_ssc/vizualization/*\nvisualizations_rgv_vs_video/*"];
  }

  // Input wiring
  occufly_raw -> occufly_depth_loader [label="RGB/depth/calibration"];
  occufly_raw -> occufly_video_builder [label="visual frames"];
  occufly_raw -> occufly_video_loader [label="frame sequences"];
  occufly_raw -> occufly_ssc_loader [label="RGB/depth/poses/intrinsics/SSC grids"];

  // External dependencies to model families
  ext_vjepa2 -> mde_lp;
  ext_vjepa2 -> mde_dino_lp;
  ext_vjepa2 -> mde_dpt;
  ext_vjepa2 -> mde_dpt_film;
  ext_vjepa2 -> rgb_ft;
  ext_vjepa2 -> video_ft;
  ext_vjepa2 -> stlp;
  ext_vjepa2 -> dta;
  ext_vjepa2 -> ssc_hybrid_backbones;
  ext_vjepa2 -> aero_model;
  ext_dinov3 -> mde_dino_lp;
  ext_dinov3 -> mde_dpt;
  ext_dinov3 -> mde_dpt_film;
  ext_dinov3 -> ssc_hybrid_geometry;
  ext_foundationssc -> ssc_hybrid_foundation;
  ext_cgformer -> cg_common;
  ext_cgformer -> aero_model;

  // MDE
  occufly_depth_loader -> mde_lp;
  occufly_depth_loader -> mde_dino_lp;
  occufly_depth_loader -> mde_dpt;
  occufly_depth_loader -> mde_dpt_film;
  occufly_depth_loader -> mde_alt;
  occufly_depth_loader -> mde_sfp;
  mde_dpt_film -> mde_outputs;
  mde_lp -> mde_outputs;
  mde_dino_lp -> mde_outputs;
  mde_dpt -> mde_outputs;
  mde_alt -> mde_outputs;
  mde_sfp -> mde_outputs;
  mde_outputs -> mde_viz_diag;

  // Finetuning and probes
  occufly_depth_loader -> rgb_ft [label="RGB only"];
  occufly_video_builder -> video_ft;
  rgb_ft -> ft_ckpts;
  video_ft -> ft_ckpts;
  ft_ckpts -> ft_probes [style=dashed, label="checkpoint reuse"];
  ft_probes -> mde_outputs [style=dashed];

  // Video depth
  occufly_video_loader -> stlp;
  occufly_video_loader -> dta;
  stlp -> video_depth_outputs;
  dta -> video_depth_outputs;
  video_depth_outputs -> global_viz;

  // Segmentation
  voc_download -> seg_linear;
  occufly_raw -> seg_linear [label="OccuFly labels/map"];
  ext_dinov3 -> seg_linear;

  // SSC wiring
  occufly_ssc_loader -> ssc_scaffold;
  occufly_ssc_loader -> ssc_frozen;
  occufly_ssc_loader -> ssc_hybrid_train;
  mde_outputs -> ssc_frozen [style=dashed, label="depth checkpoint / frozen head"];
  mde_outputs -> ssc_hybrid_geometry [style=dashed, label="DPT-depth init when geometry_branch=dpt_depth"];
  ssc_hybrid_backbones -> ssc_hybrid_train;
  ssc_hybrid_geometry -> ssc_hybrid_train;
  ssc_hybrid_foundation -> ssc_hybrid_train;
  ssc_hybrid_train -> ssc_hybrid_losses;
  ssc_hybrid_losses -> ssc_hybrid_outputs;
  ssc_hybrid_outputs -> global_viz;
  ssc_scaffold -> ssc_variants [style=dashed];
  ssc_hybrid_train -> ssc_variants [style=dashed];

  // CGFormer / Aero-JEPA
  occufly_ssc_loader -> cg_common;
  occufly_ssc_loader -> aero_data;
  cg_common -> aero_data [style=dashed, label="prepared OccuFly trees/prior paths"];
  aero_cfg -> aero_model;
  aero_data -> aero_model;
  aero_model -> aero_losses;
  aero_losses -> aero_tools;
  aero_tools -> aero_outputs;
  mde_outputs -> cg_common [style=dashed, label="V-JEPA/DPT-FiLM priors exported"];
  cg_common -> aero_outputs [style=dashed];

  // Quality/reporting
  mde_outputs -> paper_tables [style=dashed];
  video_depth_outputs -> paper_tables [style=dashed];
  ssc_hybrid_outputs -> paper_tables [style=dashed];
  aero_outputs -> paper_tables [style=dashed];
  base_tests -> occufly_depth_loader [style=dotted];
  base_tests -> ssc_hybrid_losses [style=dotted];
  cg_tests -> aero_data [style=dotted];
  cg_tests -> aero_model [style=dotted];
  cg_tests -> aero_losses [style=dotted];
}
